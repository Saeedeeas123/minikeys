<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The keyboard can only READ what is on screen; pressing a key of another app needs the
        accessibility API, which this service provides. An IME cannot do it (InputConnection only
        writes text), which is why this lives beside the keyboard rather than inside it.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application>

        <!--
            The screen reader. The system binds it when the user enables it in Accessibility settings;
            the flags in the XML are what make the windows list (and therefore "which app is really in
            front") available.
        -->
        <service
            android:name="com.saeed.minikeys.perception.ScanService"
            android:exported="true"
            android:label="@string/perception_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>