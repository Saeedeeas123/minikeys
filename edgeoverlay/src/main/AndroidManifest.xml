<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        The overlay service. The consuming app must declare SYSTEM_ALERT_WINDOW,
        FOREGROUND_SERVICE, FOREGROUND_SERVICE_SPECIAL_USE and POST_NOTIFICATIONS.
    -->
    <!-- Brings the strips (and their ON/OFF notification) back after a reboot or an app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <!--
            Restores the always-on surface after BOOT_COMPLETED / MY_PACKAGE_REPLACED. The broadcast
            is protected by RECEIVE_BOOT_COMPLETED, so only the system can trigger it.
        -->
        <receiver
            android:name="com.saeed.minikeys.edgeoverlay.OverlayBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.saeed.minikeys.edgeoverlay.EdgeOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="always_on_edge_shortcut_strips" />
        </service>
    </application>
</manifest>
