set(CMAKE_SYSTEM_NAME Android)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_ANDROID_ARCH_ABI arm64-v8a)
set(CMAKE_ANDROID_API 26)
set(CMAKE_ANDROID_STANDALONE_TOOLCHAIN /root/projects/llama-android/standalone)
set(TGT "--target=aarch64-linux-android26 --sysroot=/root/projects/llama-android/standalone/sysroot")
set(CMAKE_C_FLAGS_INIT "${TGT}")
set(CMAKE_CXX_FLAGS_INIT "${TGT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=/usr/bin/ld.lld-18 ${TGT}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=/usr/bin/ld.lld-18 ${TGT}")
